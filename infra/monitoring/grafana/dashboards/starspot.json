{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "StarSpot Observability",
  "tags": ["starspot"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "캐시 히트율 (%)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "expr": "100 * sum(rate(starspot_cache_events_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(starspot_cache_events_total{result=~\"hit|miss\"}[5m])), 1)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 2,
      "title": "API 지연 p95 (초)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(starspot_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "기상청 외부 API 실패율 (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        {
          "expr": "100 * sum(rate(starspot_kma_requests_total{outcome=\"failure\"}[5m])) / clamp_min(sum(rate(starspot_kma_requests_total[5m])), 1)",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "요청량 (req/s) by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(starspot_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "캐시 이벤트 (hit/miss/stale)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(starspot_cache_events_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
