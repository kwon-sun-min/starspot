server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # gzip
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # /api 는 백엔드(api 서비스)로 리버스 프록시.
    # 업스트림은 배포 환경마다 다르므로 API_UPSTREAM 환경변수로 주입한다.
    #  - 로컬 docker compose: http://api:8000
    #  - Railway 등: http://<api-service>.railway.internal:8000
    #
    # proxy_pass 에 변수를 쓰면 nginx 가 시작 시점이 아니라 요청 시점에 DNS 를 조회한다.
    # 덕분에 api 서비스가 아직 안 떠 있어도 nginx 가 기동에 실패하지 않는다.
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s;
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # 런타임 주입 env.js 는 캐시하지 않는다
    location = /env.js {
        add_header Cache-Control "no-store";
    }

    # SPA 라우팅: 정적 파일 없으면 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
