# ---- StarSpot environment variables (copy to .env and fill in) ----

# 기상청 단기예보 API 서비스 키 (data.go.kr 발급)
KMA_SERVICE_KEY=

# 카카오맵 JS SDK 앱 키 (로컬 개발용 / 배포용 분리 권장)
KAKAO_MAP_KEY=

# PostgreSQL + PostGIS 연결 문자열
# 로컬 docker compose 기준 서비스명(postgis)을 호스트로 사용
DATABASE_URL=postgresql+psycopg://starspot:starspot@postgis:5432/starspot

# Redis 연결 문자열
REDIS_URL=redis://redis:6379/0

# ---- Postgres 컨테이너 초기화용 (docker-compose가 사용) ----
POSTGRES_USER=starspot
POSTGRES_PASSWORD=starspot
POSTGRES_DB=starspot

# ---- 애플리케이션 설정 ----
TZ=Asia/Seoul
LOG_LEVEL=INFO
